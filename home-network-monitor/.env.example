# Copy to .env and fill in. Never commit the real .env.

# Dashboard login (HTTP Basic). Required when web.host is not 127.0.0.1.
NETMON_DASHBOARD_USER=admin
NETMON_DASHBOARD_PASSWORD=

# Only if you enable the Pi-hole / AdGuard Home importers.
NETMON_PIHOLE_PASSWORD=
NETMON_ADGUARD_USER=
NETMON_ADGUARD_PASSWORD=
